# Copie para backend/.env e ajuste.

# --- Provedor de LLM: mock | anthropic | bedrock | ollama ---------------
HIVE_LLM_PROVIDER=mock
# Roteamento por papel (opcional). Ex.: híbrido Claude + GPU local
# HIVE_ROUTING={"orchestrator": "anthropic:claude-opus-5-5"}
HIVE_MODEL_ORCHESTRATOR=claude-opus-5-5
HIVE_MODEL_WORKER=claude-sonnet-5-5

# Anthropic (API direta): o SDK lê ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# Bedrock: usa credenciais AWS padrão (perfil/IAM role)
HIVE_AWS_REGION=us-east-1

# Ollama local (Windows host visto do WSL) — ver docs/llm-local.md
HIVE_OLLAMA_URL=http://192.168.80.1:11434
HIVE_OLLAMA_MODEL=gpt-oss:20b
# Modelos com raciocínio (qwen3, gpt-oss): false = mais rápido; vazio = padrão do modelo
# HIVE_OLLAMA_THINK=false
# Chamadas simultâneas ao Ollama; alinhe com OLLAMA_NUM_PARALLEL no servidor
# HIVE_OLLAMA_MAX_PARALLEL=1
HIVE_LOCAL_GPU_WATTS=304
HIVE_ENERGY_PRICE_PER_KWH_USD=0.16

# --- Imagens: svg (LLM escreve SVG) | comfyui (SDXL local no ComfyUI) ----------
# HIVE_IMAGE_PROVIDER=svg
# HIVE_COMFYUI_URL=http://localhost:8188
# HIVE_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# --- Governança --------------------------------------------------------
HIVE_MISSION_BUDGET_USD=3.0
HIVE_MAX_REWORK_ATTEMPTS=2
HIVE_AUTO_APPROVE=false
# Simulação: latência por chamada e defeito proposital na 1ª versão do dev (demonstra retrabalho)
HIVE_MOCK_LATENCY_S=1.2
HIVE_MOCK_INJECT_DEFECT=true

# --- Infra -------------------------------------------------------------
HIVE_DATA_DIR=./data
# HIVE_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/hive
HIVE_PUBLIC_BASE_URL=http://localhost:8001

# --- Canais ------------------------------------------------------------
# Crie um bot com o @BotFather e cole o token:
# HIVE_TELEGRAM_BOT_TOKEN=123456:ABC...
